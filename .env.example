BOT_TOKEN=put_your_token_here
ALLOWED_USER_ID=put_your_id_here

# Необязательно: локальная модель для кнопки «Объяснить» (по умолчанию так и есть)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b

# Необязательно: вместо локальной модели можно взять облачный сервис с OpenAI-совместимым API,
# например бесплатный тариф Groq. Тогда код проверки и текст ошибки отправляются этому сервису.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=put_your_api_key_here
# LLM_REASONING_EFFORT=low
